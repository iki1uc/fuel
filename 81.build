import { scan9hoch9 } from "./81.scan";

async function loadROM() {
    const txt = await fetch("./81.rom").then(r => r.text());
    const rom = {};
    txt.split("\n").forEach(line => {
        const [k, v] = line.split(":").map(s => s.trim());
        if (k && v !== undefined) rom[k] = Number(v);
    });
    return Object.values(rom); // WICHTIG: Array erzeugen
}

(async () => {
    const romArray = await loadROM();
    const result = scan9hoch9(romArray);

    console.log("READY:", result.ready);
    console.log("ERRORS:", result.errors);
})();
