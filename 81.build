export function respoSlot(i, romValue) {
    return {
        value: romValue,
        pulse: Math.sin(Date.now() / 120) * Math.random(),
        drift: Math.cos(Date.now() / 240) + Math.random()*0.2,
        angle: (Date.now() / 10 + romValue * 3) % 360
    };
}

export function scan9hoch9(rom) {
    let ready = 0;
    let errors = 0;

    for (let i = 0; i < 81; i++) {
        const slot = respoSlot(i, rom[i]);

        const ok =
            slot.value >= -12 && slot.value <= 12 &&
            Math.abs(slot.pulse) <= 1.2 &&
            Math.abs(slot.drift) <= 1.2 &&
            slot.angle >= 0 && slot.angle <= 360;

        if (ok) ready++;
        else errors++;
    }

    return { ready, errors };
}
